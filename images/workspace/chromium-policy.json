{
  "_comment": "Managed policy for the workspace Chromium. Command-line --disable-features does not turn off secure-DNS auto-upgrade in this build; policy does. Nothing in the image may phone home: the only network a run may use is the Gateway and what the egress rules allow. Installed at /etc/chromium/policies/managed/ by the Dockerfile.",
  "DnsOverHttpsMode": "off",
  "SafeBrowsingProtectionLevel": 0,
  "MetricsReportingEnabled": false,
  "ComponentUpdatesEnabled": false,
  "BackgroundModeEnabled": false,
  "BrowserSignin": 0,
  "SyncDisabled": true,
  "DefaultBrowserSettingEnabled": false,
  "PromotionalTabsEnabled": false,
  "AlternateErrorPagesEnabled": false,
  "SearchSuggestEnabled": false,
  "TranslateEnabled": false,
  "SpellCheckServiceEnabled": false,
  "PasswordManagerEnabled": false,
  "AutofillAddressEnabled": false,
  "AutofillCreditCardEnabled": false,
  "NetworkPredictionOptions": 2,
  "UrlKeyedAnonymizedDataCollectionEnabled": false,
  "MediaRouterCastAllowAllIPs": false,
  "EnableMediaRouter": false,
  "CloudReportingEnabled": false,
  "ChromeVariations": 2,
  "HttpsUpgradesEnabled": false,
  "BuiltInDnsClientEnabled": false
}
