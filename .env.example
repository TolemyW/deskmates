# Copy to .env for local development. Never commit real values.
# Gateway sections follow the per-domain readers in packages/gateway/src/config/<domain>.ts.

# --- Gateway server: listeners, operator credential, database (config/server.ts) ---
GATEWAY_PORT=8080
GATEWAY_BIND=0.0.0.0            # sandbox-facing listener: /v1, /internal and /healthz only
OPERATOR_PORT=8081
OPERATOR_BIND=127.0.0.1         # operator-facing listener: /api, SSE, webhooks and (with WEB_DIST_DIR) the built UI
# For LAN access set OPERATOR_BIND=0.0.0.0 (or the host's LAN address) and give colleagues
# http://<host>:<OPERATOR_PORT>/ plus the operator token. The bind is exposure, not the boundary:
# every /api route still requires GATEWAY_OPERATOR_TOKEN, and traffic is plain HTTP unless a TLS
# proxy sits in front. Never point a LAN user at GATEWAY_PORT.
# Production requires >=32 random bytes. The local dev launcher generates and prints an ephemeral
# value when this is empty. The token is never exposed to sandboxes.
GATEWAY_OPERATOR_TOKEN=
GATEWAY_DB=./data/gateway.sqlite
GATEWAY_SECRETS_KEY=            # 32-byte base64 key for encrypting secrets at rest (refresh tokens, connector URLs and credentials); required to register a connector
GATEWAY_BASE_URL=               # URL sandboxes use to reach the Gateway (model proxy + internal routes); empty means http://host.docker.internal:<GATEWAY_PORT> for Docker. Set it when the Gateway sits behind a proxy or on another host.
DESKMATES_HOST_TARGET=              # Optional proxy destination for host.docker.internal. On Colima use host.lima.internal if the default host alias does not resolve; otherwise the fallback is the Docker VM bridge.
# Directory of the built UI (npm run build -w packages/web writes packages/web/dist). When set, the
# operator listener serves it at / with SPA fallback; startup fails if it has no index.html.
# Empty serves no UI. Never served on the sandbox listener.
WEB_DIST_DIR=
# Release tag of the running deployment, e.g. v0.2.0; shown in the UI sidebar and returned by
# GET /api/config. Empty shows no release (e.g. a working-tree run).
DESKMATES_RELEASE=

# --- Published workspace apps (ADR-0035, config/app-shares.ts); both URLs empty turns it off ---
# Each published app gets its own origin <label>.<host of APP_SHARE_BASE_URL>. The base host must be
# a DNS name that is neither the operator host nor a parent of it. *.localhost resolves to loopback
# in browsers, so http://apps.localhost:8790 works locally and through an SSH tunnel of both ports;
# a LAN deployment needs a wildcard DNS name, ideally HTTPS in front.
APP_SHARE_BASE_URL=
APP_SHARE_OPERATOR_URL=           # the operator UI's public origin, e.g. http://127.0.0.1:8081
APP_SHARE_PORT=8790
APP_SHARE_BIND=127.0.0.1

# --- Look/OCR and speech-to-text operations (ADR-0040, config/operations.ts) ---
# Each operation is on when its URL and model are both set; empty turns it and its tool off.
# A URL may be a base (the route path is appended) or the full route. The token, if any, stays in
# Gateway memory. A price is USD per image or PDF page (vision) or per audio second (ASR); empty
# means unpriced (cost unknown), 0 means a known zero. No automatic probe, retry or fallback.
VISION_OPERATION_URL=              # e.g. http://10.20.50.16:8005 (POST /v1/messages)
VISION_OPERATION_MODEL=            # e.g. qwen3.5-9b-vl
VISION_OPERATION_PROTOCOL=         # anthropic-messages (default) or openai-chat
VISION_OPERATION_AUTH_TOKEN=
VISION_OPERATION_PRICE_USD=
ASR_OPERATION_URL=                 # e.g. http://10.20.50.16:8007/v1/audio/transcriptions
ASR_OPERATION_MODEL=               # the whisper model id the service expects
ASR_OPERATION_AUTH_TOKEN=
ASR_OPERATION_PRICE_USD=
ASR_OPERATION_MAX_BYTES=           # default and ceiling 26214400 (25 MiB)
ASR_OPERATION_MAX_SECONDS=         # default 1800; checked before the call for WAV only

# --- Browser sign-in (ADR-0022 P1, config/auth.ts) ---
# People sign in with a login name and password; the session is an HttpOnly cookie. Create the
# first Owner on the Gateway host (no HTTP route can):
#   node packages/gateway/dist/auth/cli.js bootstrap-owner --login <name> --name "<display name>"
# Run it from the Gateway's working directory (a relative GATEWAY_DB resolves against it); in a
# checkout use `npm run auth -- bootstrap-owner ...`, which opens the dev Gateway's database.
# The operator token above stays for machine clients (channel adapters, acceptance stack).
# secure (default): __Host- Secure cookies, which browsers keep only over HTTPS (or localhost).
# insecure-dev: plain-HTTP development only; `npm run dev:gateway` selects it when this is empty.
GATEWAY_SESSION_COOKIE=
GATEWAY_SESSION_IDLE_TTL_SECONDS=      # default 604800 (7 days without use)
GATEWAY_SESSION_ABSOLUTE_TTL_SECONDS=  # default 2592000 (30 days after sign-in)
GATEWAY_ALLOWED_ORIGINS=               # comma-separated origins (https://deskmates.example) allowed to send signed-in mutations; empty means same host only
GATEWAY_PASSWORD_MIN_LENGTH=           # shortest accepted password, default 12; lower it only on a trial instance that wants fixed short passwords
AUTH_ARGON2_MEMORY_KIB=                # Argon2id memory, default 19456 (minimum 7168); calibrate on the host
AUTH_ARGON2_ITERATIONS=                # default 2
AUTH_ARGON2_PARALLELISM=               # default 1

# --- Model endpoint (Anthropic Messages protocol, config/model.ts) ---
# Any endpoint that speaks the Anthropic protocol works: the Anthropic API itself or a proxy in front of it.
# The Gateway holds this. Sandboxes only ever receive a short-lived token derived from it.
MODEL_BASE_URL=                 # e.g. https://api.anthropic.com  or  https://model-gateway.example.com/anthropic
MODEL_AUTH_TOKEN=               # Bearer token for MODEL_BASE_URL (sent as Authorization: Bearer, not x-api-key)
# More upstreams (ADR-0039). MODEL_BASE_URL above is the upstream `default`, which serves every model
# id not listed here. Each entry serves exactly the model ids it lists; a model id may be listed once.
# `protocol` must be "anthropic" (Messages API). `authToken` is optional: without it no Authorization
# header is sent (local model servers). The model proxy routes each request by its model id and never
# falls back to another upstream. MODEL_BASE_URL may be empty when this lists at least one upstream;
# then a model listed nowhere is refused (503 model_upstream_missing). JSON on one line, e.g.:
#   [{"id":"local-9b","baseUrl":"http://10.0.0.5:8003","models":["qwen3.5-9b"],"protocol":"anthropic"},
#    {"id":"local-27b","baseUrl":"http://10.0.0.5:8004","models":["qwen3.8-27b"],"protocol":"anthropic"}]
# Price free local models at an explicit zero in MODEL_PRICES; a model with no price row stays unpriced.
MODEL_UPSTREAMS=
DEFAULT_MODEL=                  # model id an upstream serves, e.g. claude-opus-5
CHEAP_MODEL=                    # cheaper model for low-stakes turns; may be on any upstream, e.g. qwen3.8-27b
# The model proxy forwards a run's request only when it names the run's model or cheap model
# (ADR-0023); any other id is refused with 403 model_not_selected. If the CLI's own background
# calls name a fixed id (look for refused rows in model_requests), set it here and the proxy
# rewrites it to the run's cheap model instead. Leave empty when none has been observed.
CLI_SMALL_FAST_MODEL=
# Optional single model id the Agent SDK falls back to when the primary is overloaded or
# unavailable (ADR-0023). Frozen on each run, allowed by the model proxy for that run, and it must
# have a MODEL_PRICES row or the Gateway refuses to start. Empty: no fallback.
FALLBACK_MODEL=
# Vision probe (ADR-0023 amendment 1): `auto` (empty) runs one small synthetic image probe as a
# recorded run when a bot is created or its model changes, and once at start for models in use
# without a result; `off` runs none, and every model then shows vision as unknown.
VISION_PROBE=
# Defaults introduced by ADR-0002 review; empty means built-in default
MODEL_TOKEN_TTL_SECONDS=

# --- Pricing (M1). The Gateway prices tokens itself and ignores the SDK's reported cost. ---
# JSON array of rows, one per model and effective date. USD per million tokens:
#   [{"model": "<id>", "inputPerM": 0, "outputPerM": 0, "cacheReadPerM": 0, "cacheCreatePerM": 0,
#     "effectiveFrom": "2026-01-01T00:00:00.000Z"}]
# `effectiveFrom` is optional and defaults to the epoch, so the row prices runs that already
# happened. Price DEFAULT_MODEL and CHEAP_MODEL here: a model with no row is left unpriced, with a
# `pricing_missing` event on the run. A bad row fails startup. Editable at runtime: PUT /api/prices.
MODEL_PRICES=

# --- Sandbox provider, egress and workspace limits (config/sandbox.ts) ---
SANDBOX_PROVIDER=docker         # docker | desktop-vm (M3)
DOCKER_HOST=                    # leave empty to use the default socket / current context
WORKSPACE_IMAGE=deskmates/workspace:dev
EGRESS_PROXY_IMAGE=             # empty uses deskmates/egress-proxy:dev
# Stable host only: an Ubuntu mirror for `stable.sh install` when it builds the workspace base on
# the host (LOCAL_BASE=1), e.g. https://mirrors.tuna.tsinghua.edu.cn/ubuntu. Empty uses the
# official archive. It changes where packages download from, not which versions install.
APT_MIRROR=
# DNS servers of each workspace's egress proxy container, comma-separated IP addresses
# (e.g. 223.5.5.5,8.8.8.8). Empty keeps Docker's embedded resolver. Set it where the host resolver
# answers public names with fake IPs (198.18.0.0/15), which the proxy denies as non-public.
# An invalid entry stops the Gateway at startup (ADR-0010). The workspace container has no resolver.
# It does not help where every port-53 query is intercepted (a TUN-mode proxy); use the next one.
EGRESS_PROXY_DNS=
# JSON DNS-over-HTTPS endpoint the egress proxy resolves names through instead of port 53, e.g.
# https://223.5.5.5/resolve. Must be https with an IP-literal host (a hostname would be resolved
# through the intercepted path). Empty keeps port-53 DNS. Failures and fake/private answers deny.
# If both are set, this decides the proxy's lookups (ADR-0010 decision 4a).
EGRESS_PROXY_DOH_URL=
# ADR-0027 operator-only JSON array: workspaceId, hostname, RFC1918 address, port 443, expiresAt.
# Explicit hostname allowlist also required; empty disables private HTTPS access.
EGRESS_PRIVATE_TARGETS=
# ADR-0027 amendment 2: comma-separated IPv4 CIDRs of the LAN this host reaches (e.g.
# 172.16.0.0/16). The Gateway warns at startup when one overlaps a Docker network; advisory only.
NETWORK_LAN_CIDRS=
# No cap on how many runs a workspace or tenant has at once (ADR-0022 amendment 5): these two
# container limits bound all of a workspace's runs together.
WORKSPACE_MEMORY_LIMIT_MB=      # memory ceiling of one workspace container (default 8192); a workspace holds Chromium, Xvfb and ~1 GiB per live sidecar. Recorded in runs.config_json
WORKSPACE_CPU_LIMIT=            # CPU cores of one workspace container, fractions allowed (default 4, 0 = no limit). Recorded in runs.config_json
# Operator file download (ADR-0014); empty means built-in default
FILE_DOWNLOAD_MAX_BYTES=        # largest streamed workspace file download (default 1073741824 / 1 GiB); bounded range previews may inspect larger files
FILE_UPLOAD_WORKSPACE_QUOTA_BYTES= # disclosed per-workspace upload quota (ADR-0014 A5; empty or 0 = none); there is no per-file upload cap

# --- Run knobs (config/runs.ts); empty means built-in default ---
# Defaults introduced by ADR-0005 review
THREAD_PAYLOAD_MAX_TOKENS=
RUN_TIMEOUT_SECONDS=            # wall-clock deadline for one sidecar process (default 1800); recorded in runs.config_json
DESKMATES_MAX_TURNS=               # SDK maxTurns per run (default 80); recorded in runs.config_json
# Routing of a message with no explicit recipient in a group (ADR-0005 amendment 2); empty keeps owner-v1.
DESKMATES_GROUP_ROUTING=          # owner-v1 | walk-v1; recorded per run as groupRouting
# Where a run starts (issue #88, ADR-0038); empty means per-bot: /work/bots/<bot>, teammates' directories read-only (soft guard).
DESKMATES_BOT_WORKDIR=            # per-bot | shared (/work); a workspace setting overrides it; recorded per run as botWorkdir
# Triggers (M1); empty means built-in default, all recorded in runs.config_json
CRON_TIMEZONE=                  # IANA zone cron schedules are read in, e.g. Asia/Shanghai; empty means the Gateway process's own zone
WEBHOOK_BODY_MAX_BYTES=         # largest accepted webhook body (default 65536); a larger one is 413 and creates no run
WEBHOOK_QUEUE_MAX=              # queued webhook runs per bot (default 20); past it a delivery is 429 queue_full

# --- CLI surface (ADR-0023 amendment 5, config/cli-surface.ts); all empty changes nothing ---
# Stamped on each run as cliSurface; a strategy change, judged by a paired eval like any other.
DESKMATES_CLI_DISALLOWED_TOOLS=          # comma-separated built-in CLI tool names withheld on top of the sidecar's fixed list
DESKMATES_CLI_DISABLE_BUNDLED_SKILLS=    # true | false; empty keeps the CLI's bundled skills
DESKMATES_CLI_INCLUDE_GIT_INSTRUCTIONS=  # true | false; empty keeps the CLI's commit and PR workflow text
DESKMATES_CLI_SKILL_LISTING_MAX_DESC_CHARS= # per-skill description cap in the skill listing; empty keeps the CLI's 1536

# --- Hybrid Knowledge and memory search (ADR-0041, config/retrieval.ts); all empty keeps FTS5 ---
# A strategy change: not "better" until a paired eval says so. Each URL/MODEL pair is set together.
EMBEDDING_URL=                  # ollama /api/embed (or an OpenAI /v1/embeddings URL), e.g. http://host:11434/api/embed
EMBEDDING_MODEL=                # the embedding model id that service serves
RERANK_URL=                     # vLLM/Jina-style rerank endpoint, e.g. http://host:8899/rerank
RERANK_MODEL=                   # the rerank model id that service serves
RETRIEVAL_CANDIDATES=           # candidates from each of bm25 and vectors (default 50)
RETRIEVAL_RRF_K=                # reciprocal rank fusion constant (default 60)
RERANK_TOP_N=                   # fused candidates the reranker reorders (default 20)
RETRIEVAL_MIN_SIMILARITY=       # cosine floor for a vector-only candidate (default 0.45)

# --- Shared browser (config/browser.ts) ---
# ADR-0007 experimental origin queue; empty keeps tab-v1. Requires a matching sidecar image.
BROWSER_COORDINATION_MODE=      # tab-v1 | origin-v2; recorded per run, queue waiting consumes RUN_TIMEOUT_SECONDS
# Experimental fresh page state after browser actions; empty keeps explicit-v1.
BROWSER_SNAPSHOT_MODE=          # explicit-v1 | inline-v2; requires matching sidecar image, recorded per run
# Opt-in strategy; evaluate separately before deployment.
BROWSER_EXECUTION_MODE=baseline-v1
# ADR-0002 amendment 5 (proposed): tier browser code by its effects; empty keeps name-v1. An
# approval-rule change: needs owner sign-off and a paired evaluation before a deployment sets it.
BROWSER_CODE_APPROVAL=          # name-v1 | effects-v1; recorded per run
# Completed bot tabs only; human/active/parked tabs are preserved.
BROWSER_RETAINED_TABS=20
BROWSER_TAB_RETENTION_HOURS=24

# --- Tenancy and per-tenant limits (config/tenancy.ts) ---
# single (default) or multi (ADR-0022, docs/runbooks/multi-tenant.md). multi starts only after
# `auth-cli preflight` passes. GATEWAY_OPERATOR_TOKEN always acts in the Default Tenant only.
DESKMATES_TENANCY=
# Queued runs per tenant and operator API requests per minute per tenant (ADR-0022 LIMIT-01; 0 = off).
TENANT_MAX_QUEUED_RUNS=200
TENANT_API_REQUESTS_PER_MINUTE=1200
# Open event streams and desktop connections (tickets plus open streams) per tenant (0 = off).
TENANT_MAX_EVENT_STREAMS=200
TENANT_MAX_DESKTOP_CONNECTIONS=32
# Workspace disk quota in MiB over /work, /home and /profile; empty or 0 = no quota.
WORKSPACE_DISK_QUOTA_MB=

# --- Connectors, integration runtime and channels (config/integrations.ts) ---
CONNECTOR_VALIDATION_TTL_SECONDS= # how long a connector validation may be submitted (default 900, ADR-0012); recorded in runs.config_json
# Integration runtime (ADR-0013); all empty means no integration is offered to any run.
# The runtime (OpenConnector) runs as its own container on a network only the Gateway reaches;
# see docs/runbooks/stable-release.md. URL and admin token come together or not at all.
INTEGRATION_RUNTIME_URL=         # e.g. http://integration-runtime:3000 on the Gateway-only network; never reachable from a workspace
INTEGRATION_RUNTIME_ADMIN_TOKEN= # the runtime's OOMOL_CONNECT_ADMIN_TOKEN; held in memory only, never stored or sent to a sandbox
INTEGRATION_OAUTH_CALLBACK_URL=  # public HTTPS URL of the operator listener's /api/integrations/oauth/callback; empty disables OAuth grants (API-key connections still work)
# Release-bundled channel plugins (ADR-0017 amendment 1); read by the Gateway.
# `npm run build -w packages/channels` writes this manifest. A packaged release pins an absolute path.
CHANNEL_PLUGIN_MANIFEST=
# Private operator data, outside every workspace. QR credentials are retained across restarts.
CHANNEL_STATE_DIR=./data/channels

# --- Web UI dev server ---
WEB_PORT=5173                   # Vite dev server only (npm run dev:web)

# --- Legacy WhatsApp diagnostic binary (ADR-0017); not the product lifecycle ---
# The adapter is an operator-side service: it holds the operator token and the WhatsApp credentials in
# memory, listens on plain HTTP behind the operator's TLS reverse proxy (Meta requires HTTPS), and never
# runs inside a workspace. Account prerequisites (WABA, permanent System User token, app secret, webhook
# subscription) are listed in the ADR; none of them is established by code.
WHATSAPP_PORT=8090
WHATSAPP_BIND=127.0.0.1
WHATSAPP_VERIFY_TOKEN=          # your own value; Meta echoes it in the subscription handshake
WHATSAPP_APP_SECRET=            # the Meta app's secret; signs every webhook body (X-Hub-Signature-256)
WHATSAPP_ACCESS_TOKEN=          # permanent System User token with whatsapp_business_messaging
WHATSAPP_PHONE_NUMBER_ID=       # the business number the adapter speaks for; other numbers are dropped
WHATSAPP_GRAPH_BASE_URL=        # empty uses https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=     # empty uses v23.0 (a guess; confirm against Meta's changelog)
WHATSAPP_ALLOWED_SENDERS=       # comma-separated wa_ids (E.164 digits) that may drive the bots; empty admits nobody
WHATSAPP_GATEWAY_URL=           # the Gateway's operator listener, e.g. http://127.0.0.1:8081
WHATSAPP_WORKSPACE_ID=          # where a sender's first message creates its thread
WHATSAPP_BOT_IDS=               # comma-separated members of each new WhatsApp thread
WHATSAPP_STATE_FILE=            # per-thread relay cursors; empty uses ./data/whatsapp-state.json
WHATSAPP_SEND_RETRIES=          # retries on 429/5xx from the Graph API (default 3)

# --- WhatsApp QR login (ADR-0019); deskmates-whatsapp-web, no Meta/WABA fields needed ---
# Reuses GATEWAY_OPERATOR_TOKEN, WHATSAPP_GATEWAY_URL, WHATSAPP_WORKSPACE_ID,
# WHATSAPP_BOT_IDS and WHATSAPP_ALLOWED_SENDERS above. Include your own number for self-chat.
WHATSAPP_WEB_BIND=127.0.0.1
WHATSAPP_WEB_PORT=8091
WHATSAPP_WEB_DATA_DIR=./data/whatsapp-web  # private session; never mount into a workspace
WHATSAPP_WEB_PROXY_URL=         # optional HTTP(S) proxy; otherwise follows standard proxy environment
