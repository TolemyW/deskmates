{
  "name": "@deskmates/channels",
  "version": "0.1.0",
  "private": true,
  "description": "Release-bundled chat-channel plugins loaded by the Gateway through the versioned ChannelPlugin contract.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "deskmates-whatsapp": "./dist/index.js",
    "deskmates-whatsapp-web": "./dist/whatsapp-web-main.js"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/write-channel-plugin-manifest.mjs dist",
    "test": "vitest run --passWithNoTests --config ../../vitest.config.ts",
    "start": "node dist/index.js",
    "start:whatsapp-web": "node dist/whatsapp-web-main.js"
  },
  "files": ["dist"],
  "dependencies": {
    "@deskmates/contracts": "*",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "https-proxy-agent": "7.0.6",
    "pino": "9.6.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5"
  }
}
