{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client", "node"],
    "paths": {
      "@deskmates/contracts": ["../contracts/src/index.ts"],
      "@/*": ["./src/*"],
      "@deskmates/ui": ["../ui/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
